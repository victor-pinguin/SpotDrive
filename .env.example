# Kopiere diese Datei nach `.env` (wird nicht eingecheckt/zippt nicht mit) und trage DEINE Werte ein.

# Google Maps JavaScript API – Schlüssel in der Cloud Console auf HTTP-Referrer (+ App-ID) und
# auf "Maps JavaScript API" beschränken, Budget-Warnung aktivieren. Leer = kostenlose Leaflet-Karte.
VITE_GOOGLE_MAPS_KEY=

# Adresse des SpotDrive-Servers (npm run server). Leer = gleicher Host (/api).
VITE_API_URL=

# Release-Builds: Demo-Freischaltung von Pro abschalten (1) – dann geht Pro nur über echte Zahlung.
VITE_DISABLE_DEMO_PRO=

# Nur native App (RevenueCat öffentlicher SDK-Key appl_… / goog_…), siehe src/services/purchases.native.example.ts.txt
VITE_REVENUECAT_KEY=

# ── Nur für den SERVER (server/*.mjs), NIE in die App oder ins Repo ──
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# STRIPE_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_AUTH=
# APP_URL=https://deine-domain.de
